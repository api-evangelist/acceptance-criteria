{
  "opencollection": "1.0.0",
  "info": {
    "name": "Management Acceptance Criteria BDD Scenarios API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "BDD Scenarios",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List BDD scenarios",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.example.com/v1/scenarios",
            "params": [
              {
                "name": "storyId",
                "value": "",
                "type": "query",
                "description": "Filter scenarios by parent user story"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by scenario test status"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of Gherkin BDD scenarios derived from acceptance criteria"
        },
        {
          "info": {
            "name": "Create a BDD scenario",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.example.com/v1/scenarios",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new Gherkin BDD scenario linked to an acceptance criterion"
        }
      ]
    }
  ],
  "bundled": true
}