{
  "opencollection": "1.0.0",
  "info": {
    "name": "Management Acceptance Criteria Test Runs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Test Runs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List acceptance test runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.example.com/v1/test-runs",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of acceptance test run executions with pass/fail results"
        },
        {
          "info": {
            "name": "Create a test run",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.example.com/v1/test-runs",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Triggers execution of acceptance criteria tests for a story or set of scenarios"
        }
      ]
    }
  ],
  "bundled": true
}