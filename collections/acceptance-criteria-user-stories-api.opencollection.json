{
  "opencollection": "1.0.0",
  "info": {
    "name": "Management Acceptance Criteria User Stories API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User Stories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List user stories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.example.com/v1/stories",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by story status"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of user stories with their associated acceptance criteria"
        },
        {
          "info": {
            "name": "Create a user story",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.example.com/v1/stories",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new user story with optional acceptance criteria"
        },
        {
          "info": {
            "name": "Get a user story",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.example.com/v1/stories/:storyId",
            "params": [
              {
                "name": "storyId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a specific user story with all its acceptance criteria"
        },
        {
          "info": {
            "name": "Update a user story",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.example.com/v1/stories/:storyId",
            "params": [
              {
                "name": "storyId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a user story including its acceptance criteria"
        }
      ]
    }
  ],
  "bundled": true
}